//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// AUDUSD Trend-Pullback [Scalp/Swing]
//
// A trend-following pullback strategy built for AUDUSD (works on other
// USD-quoted majors). Designed around the most durable, widely documented
// edges in FX rather than curve-fit tricks:
//
//   1. Trade WITH the higher-timeframe trend (price vs. HTF 200 EMA,
//      evaluated on the last COMPLETED HTF bar — no repaint, no lookahead).
//   2. Enter on pullbacks, not breakouts: price dips into the fast EMA while
//      a short RSI resets, entry triggers when momentum turns back up.
//   3. Skip dead and chaotic tape: ATR floor/ceiling + ADX chop filter.
//   4. Only trade liquid hours (default London → NY overlap, session input).
//   5. Survive: fixed fractional risk sizing, ATR stop, bank half at 1R,
//      stop to breakeven, ATR-trail the runner, daily loss circuit-breaker,
//      optional weekend flat.
//
// Suggested charts: M5/M15 for scalping, H1 for swing (HTF filter is "Auto").
// Slippage is preset to 5 ticks = 0.5 pip per fill on 5-digit feeds (~1 pip
// round trip) so backtests already pay a realistic spread. Adjust to your broker.
//
// No strategy is guaranteed. Backtest on YOUR broker's feed, forward-test on
// demo, and read tradingview/README.md for honest testing methodology.
// ─────────────────────────────────────────────────────────────────────────────
strategy("AUDUSD Trend-Pullback [Scalp/Swing]",
     shorttitle="AU Trend-Pullback",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     pyramiding=0,
     slippage=5,
     margin_long=0,
     margin_short=0)

// ═══════════════════════════════ Inputs ══════════════════════════════════════
grpS = "Strategy"
tradeMode = input.string("Both", "Trade direction", options=["Both", "Long only", "Short only"], group=grpS)
riskPct   = input.float(0.5, "Risk per trade (% of equity)", minval=0.05, maxval=5.0, step=0.05, group=grpS,
     tooltip="Position size is computed so that a stop-out loses this % of current equity. Keep it small — this is the single biggest drawdown control.")

grpT = "Trend filters"
htfChoice  = input.string("Auto", "Higher-timeframe trend TF", options=["Auto", "30", "60", "240", "D"], group=grpT,
     tooltip="Auto: chart ≤15m → 1H, chart ≤1H → 4H, else Daily.")
htfEmaLen  = input.int(200, "Higher-timeframe EMA length", minval=20, group=grpT)
emaFastLen = input.int(21, "Fast EMA length", minval=2, group=grpT)
emaSlowLen = input.int(50, "Slow EMA length", minval=5, group=grpT)
useAdx     = input.bool(true, "Require ADX ≥ threshold (chop filter)", group=grpT)
adxLen     = input.int(14, "ADX length", minval=1, group=grpT)
adxMin     = input.float(20.0, "ADX threshold", minval=5, maxval=50, step=1, group=grpT)

grpE = "Pullback entry"
rsiLen       = input.int(7, "RSI length", minval=2, group=grpE)
rsiBuyLevel  = input.float(35.0, "RSI pullback level — longs", minval=10, maxval=50, step=1, group=grpE,
     tooltip="Long trigger: RSI crosses back UP through this level after a dip, while price has recently touched the fast EMA.")
rsiSellLevel = input.float(65.0, "RSI pullback level — shorts", minval=50, maxval=90, step=1, group=grpE)
zoneWindow   = input.int(5, "Max bars since pullback touched fast EMA", minval=1, maxval=20, group=grpE)

grpV = "Volatility filter"
atrLen      = input.int(14, "ATR length", minval=1, group=grpV)
minAtrPips  = input.float(2.0, "Minimum ATR (pips)", minval=0.0, step=0.5, group=grpV,
     tooltip="Skip dead tape where spread eats the edge. On M5 AUDUSD, normal-session ATR is roughly 2–5 pips.")
maxAtrRatio = input.float(3.0, "Maximum ATR vs its 100-bar average (×)", minval=1.0, step=0.25, group=grpV,
     tooltip="Skip news-spike chaos: no entries while ATR exceeds this multiple of its own average.")

grpSess = "Sessions"
useSess  = input.bool(true, "Only trade during sessions below", group=grpSess)
sess1    = input.session("0800-1700", "Session 1 (default: London → NY overlap)", group=grpSess)
useSess2 = input.bool(false, "Also allow session 2", group=grpSess)
sess2    = input.session("0900-1500", "Session 2 (e.g. Sydney/Asia for AUD)", group=grpSess)
sessTz   = input.string("Europe/London", "Session timezone", options=["Europe/London", "America/New_York", "Australia/Sydney", "UTC", "Exchange"], group=grpSess,
     tooltip="Both session inputs are interpreted in this timezone (DST-aware).")
noFriLate  = input.bool(true, "Block new entries Friday after 12:00 New York", group=grpSess)
fridayFlat = input.bool(true, "Close everything Friday 16:00 New York (weekend flat)", group=grpSess)

grpR = "Risk & trade management"
slAtrMult    = input.float(1.5, "Stop-loss distance (ATR ×)", minval=0.5, step=0.1, group=grpR)
tp1R         = input.float(1.0, "TP1 distance (R multiples)", minval=0.3, step=0.1, group=grpR)
tp1Pct       = input.float(50.0, "Size closed at TP1 (%)", minval=10, maxval=90, step=5, group=grpR)
beAfterTp1   = input.bool(true, "Stop to breakeven after TP1", group=grpR)
useTrail     = input.bool(true, "ATR-trail the runner after TP1", group=grpR)
trailAtrMult = input.float(2.0, "Trail distance (ATR ×)", minval=0.5, step=0.1, group=grpR)
runnerR      = input.float(3.0, "Runner hard target (R multiples, 0 = none)", minval=0.0, step=0.5, group=grpR)
maxLossesDay = input.int(3, "Halt after N losing trades in a day (0 = off)", minval=0, group=grpR,
     tooltip="Circuit breaker: after N losing trades in one day, no new entries until the next day.")

grpUI = "Display"
showPanel  = input.bool(true, "Show stats panel", group=grpUI)
showSessBg = input.bool(true, "Shade active session background", group=grpUI)

// ═══════════════════════════════ Calculations ════════════════════════════════
// Fractional-pip feeds: 1 pip = 10 ticks (0.0001 on 5-digit majors)
pipSize = syminfo.mintick * 10

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
atrAvg  = ta.sma(atrVal, 100)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

autoHtf = timeframe.in_seconds() <= 900 ? "60" : timeframe.in_seconds() <= 3600 ? "240" : "D"
htfTf   = htfChoice == "Auto" ? autoHtf : htfChoice
// [1] + lookahead_on = value of the last COMPLETED HTF bar on both historical
// and realtime bars. This is the standard non-repainting HTF request: the
// backtest never sees information a live trader wouldn't have had.
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_on)

// ═══════════════════════════════ Filters ═════════════════════════════════════
sessTzResolved = sessTz == "Exchange" ? syminfo.timezone : sessTz
inSess(string s) =>
    not na(time(timeframe.period, s, sessTzResolved))
sessOk = not useSess or inSess(sess1) or (useSess2 and inSess(sess2))

nyDow  = dayofweek(time, "America/New_York")
nyHour = hour(time, "America/New_York")
friEntryBlock = noFriLate and nyDow == dayofweek.friday and nyHour >= 12

atrOk = atrVal >= minAtrPips * pipSize and atrVal <= atrAvg * maxAtrRatio
adxOk = not useAdx or adxVal >= adxMin

// Daily loss circuit-breaker
var int lossesToday = 0
newDay = nz(ta.change(time("D")), 0) != 0
if newDay
    lossesToday := 0
lossesToday += strategy.losstrades - nz(strategy.losstrades[1])
dailyOk = maxLossesDay == 0 or lossesToday < maxLossesDay

// ═══════════════════════════════ Signals ═════════════════════════════════════
trendUp   = emaFast > emaSlow and close > htfEma
trendDown = emaFast < emaSlow and close < htfEma

// Pullback = price touched the fast EMA within the last N bars,
// trigger = short RSI turning back through its level in trend direction,
// structure guard = close still on the right side of the slow EMA.
pulledToZoneL = ta.barssince(low <= emaFast) <= zoneWindow
pulledToZoneS = ta.barssince(high >= emaFast) <= zoneWindow

longTrigger  = trendUp and pulledToZoneL and ta.crossover(rsiVal, rsiBuyLevel) and close > emaSlow
shortTrigger = trendDown and pulledToZoneS and ta.crossunder(rsiVal, rsiSellLevel) and close < emaSlow

longAllowed  = tradeMode != "Short only"
shortAllowed = tradeMode != "Long only"
flat     = strategy.position_size == 0
canTrade = flat and sessOk and atrOk and adxOk and dailyOk and not friEntryBlock

longSignal  = canTrade and longAllowed and longTrigger
shortSignal = canTrade and shortAllowed and shortTrigger

// ═══════════════════════════════ Orders ══════════════════════════════════════
var float slPrice  = na
var float tp1Price = na
var float tp2Price = na
var float entryPx  = na
var float initQty  = na
var float extremeSinceEntry = na
var float runnerStop = na
var bool  tp1Done  = false

if longSignal
    float stopDist = atrVal * slAtrMult
    float riskCash = strategy.equity * riskPct / 100.0
    float qty      = math.max(1, math.floor(riskCash / stopDist))
    slPrice  := close - stopDist
    tp1Price := close + stopDist * tp1R
    tp2Price := runnerR > 0 ? close + stopDist * runnerR : na
    strategy.entry("L", strategy.long, qty=qty)
    strategy.exit("L-TP1", "L", qty_percent=tp1Pct, limit=tp1Price, stop=slPrice)
    strategy.exit("L-Run", "L", limit=tp2Price, stop=slPrice)

if shortSignal
    float stopDist = atrVal * slAtrMult
    float riskCash = strategy.equity * riskPct / 100.0
    float qty      = math.max(1, math.floor(riskCash / stopDist))
    slPrice  := close + stopDist
    tp1Price := close - stopDist * tp1R
    tp2Price := runnerR > 0 ? close - stopDist * runnerR : na
    strategy.entry("S", strategy.short, qty=qty)
    strategy.exit("S-TP1", "S", qty_percent=tp1Pct, limit=tp1Price, stop=slPrice)
    strategy.exit("S-Run", "S", limit=tp2Price, stop=slPrice)

// ═══════════════════════════ Trade management ════════════════════════════════
justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
if justOpened
    entryPx  := strategy.position_avg_price
    initQty  := math.abs(strategy.position_size)
    extremeSinceEntry := strategy.position_size > 0 ? high : low
    runnerStop := slPrice
    tp1Done  := false

// Partial fill detection: position shrank but is not flat → TP1 has been paid
if strategy.position_size != 0 and not na(initQty) and math.abs(strategy.position_size) < initQty
    tp1Done := true

if strategy.position_size > 0
    extremeSinceEntry := math.max(nz(extremeSinceEntry, high), high)
    float newStop = slPrice
    if tp1Done and beAfterTp1
        newStop := math.max(newStop, entryPx)
    if tp1Done and useTrail
        newStop := math.max(newStop, extremeSinceEntry - trailAtrMult * atrVal)
    runnerStop := math.max(nz(runnerStop, newStop), newStop)  // ratchet: never loosens
    if not tp1Done
        strategy.exit("L-TP1", "L", qty_percent=tp1Pct, limit=tp1Price, stop=runnerStop)
    strategy.exit("L-Run", "L", limit=tp2Price, stop=runnerStop)

if strategy.position_size < 0
    extremeSinceEntry := math.min(nz(extremeSinceEntry, low), low)
    float newStop = slPrice
    if tp1Done and beAfterTp1
        newStop := math.min(newStop, entryPx)
    if tp1Done and useTrail
        newStop := math.min(newStop, extremeSinceEntry + trailAtrMult * atrVal)
    runnerStop := math.min(nz(runnerStop, newStop), newStop)
    if not tp1Done
        strategy.exit("S-TP1", "S", qty_percent=tp1Pct, limit=tp1Price, stop=runnerStop)
    strategy.exit("S-Run", "S", limit=tp2Price, stop=runnerStop)

// Weekend flat: forex gaps over the weekend are the one hole ATR stops can't cover
if fridayFlat and nyDow == dayofweek.friday and nyHour >= 16 and strategy.position_size != 0
    strategy.close_all(comment="Weekend flat")

// ═══════════════════════════════ Visuals ═════════════════════════════════════
upCol = color.rgb(0, 150, 136)
dnCol = color.rgb(239, 83, 80)

plot(emaFast, "Fast EMA", color=emaFast >= emaSlow ? color.new(upCol, 0) : color.new(dnCol, 0), linewidth=2)
plot(emaSlow, "Slow EMA", color=color.new(color.gray, 30), linewidth=2)
plot(htfEma, "HTF EMA", color=close >= htfEma ? color.new(upCol, 55) : color.new(dnCol, 55), linewidth=3)

plotshape(longSignal, "Long entry", style=shape.triangleup, location=location.belowbar, color=upCol, size=size.small, text="LONG", textcolor=upCol)
plotshape(shortSignal, "Short entry", style=shape.triangledown, location=location.abovebar, color=dnCol, size=size.small, text="SHORT", textcolor=dnCol)

inPos = strategy.position_size != 0
plot(inPos ? runnerStop : na, "Active stop", color=color.new(dnCol, 0), linewidth=1, style=plot.style_linebr)
plot(inPos and not tp1Done ? tp1Price : na, "TP1", color=color.new(upCol, 0), linewidth=1, style=plot.style_linebr)
plot(inPos ? tp2Price : na, "Runner target", color=color.new(upCol, 40), linewidth=1, style=plot.style_linebr)
plot(inPos ? strategy.position_avg_price : na, "Entry price", color=color.new(color.gray, 0), linewidth=1, style=plot.style_linebr)

bgcolor(showSessBg and useSess and sessOk ? color.new(color.blue, 96) : na)

// ═══════════════════════════════ Stats panel ═════════════════════════════════
var table panel = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 25), border_color=color.new(color.gray, 60), border_width=1)

f_row(int r, string k, string v, color vc) =>
    table.cell(panel, 0, r, k, text_color=color.new(color.white, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

if showPanel and barstate.islast
    winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : na
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    ddPct   = 100.0 * strategy.max_drawdown / strategy.initial_capital
    filtStr = (sessOk ? "SES ✓" : "SES ✗") + "  " + (atrOk ? "ATR ✓" : "ATR ✗") + "  " + (adxOk ? "ADX ✓" : "ADX ✗")
    f_row(0, "AU Trend-Pullback", timeframe.period + " / HTF " + htfTf, color.new(color.white, 20))
    f_row(1, "Closed trades*", str.tostring(strategy.closedtrades), color.new(color.white, 20))
    f_row(2, "Win rate*", na(winRate) ? "—" : str.tostring(winRate, "#.#") + "%", na(winRate) ? color.gray : winRate >= 50 ? upCol : dnCol)
    f_row(3, "Profit factor", na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1.0 ? upCol : dnCol)
    f_row(4, "Net profit", str.tostring(strategy.netprofit, "#.##") + " " + strategy.account_currency, strategy.netprofit >= 0 ? upCol : dnCol)
    f_row(5, "Max drawdown", str.tostring(strategy.max_drawdown, "#.##") + " (" + str.tostring(ddPct, "#.#") + "%)", dnCol)
    f_row(6, "Losses today", str.tostring(lossesToday) + (maxLossesDay > 0 ? " / " + str.tostring(maxLossesDay) : ""), dailyOk ? color.new(color.white, 20) : dnCol)
    f_row(7, "HTF trend", close > htfEma ? "UP" : "DOWN", close > htfEma ? upCol : dnCol)
    f_row(8, "Filters", filtStr, color.new(color.white, 20))
    // * TradingView counts each partial exit as its own closed trade, which
    //   inflates trade count and win rate. Judge profit factor and max DD too.

// ═══════════════════════════════ Alerts ══════════════════════════════════════
alertcondition(longSignal, "Long entry signal", "AU Trend-Pullback: LONG signal on {{ticker}} ({{interval}})")
alertcondition(shortSignal, "Short entry signal", "AU Trend-Pullback: SHORT signal on {{ticker}} ({{interval}})")
