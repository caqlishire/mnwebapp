//@version=6
// =============================================================================
//  AUDUSD MONTH-END FIX FADE  -  scalp, price + clock only, no indicators
//  -----------------------------------------------------------------------------
//  WHY IT WORKS
//    On the last trading day of each month, large portfolio-rebalancing and
//    currency-hedge orders are executed at the WM/Reuters London 4pm fix
//    (16:00 London). They push AUDUSD in the half hour before the fix. At 16:00
//    the orders are done, the pressure stops, and price tends to give part of
//    that move back.
//
//  RULES (London time, closed bars only - nothing repaints)
//    1 Day      Last trading day (Mon-Fri) of the month.
//    2 Measure  The move from 15:30 to 16:00. Skip it if smaller than 3 pips.
//    3 Entry    At 16:00, trade AGAINST that move (pushed up -> SELL).
//    4 Stop     20 pips.
//    5 Target   The 15:30 price (the move is fully given back).
//    6 Exit     If neither is hit, close at 17:00.
//
//  EVIDENCE (Oanda AUDUSD 1-minute data, Jan 2005 - May 2020, 1 pip round-trip
//  cost, entry at the first price after 16:00, exit at the first after 17:00)
//    158 trades, 70% winners, +3.0 pips average, profit factor 1.9, max
//    drawdown 62 pips, 13 of 16 years positive, longest losing streak 3.
//    The rules were fixed on 2005-2016 data and then tested once on unseen
//    2017-2020 data: 35 trades, 71% winners, +2.9 pips average, PF 2.3.
//    The same rule on EURUSD, GBPUSD and USDCAD did NOT hold in 2017-2020, so
//    use it on AUDUSD only. At most one trade per month (about 10 a year).
//
//  CHART: AUDUSD (OANDA or FX), 1 to 15 minute timeframe. Execution speed
//  matters: entering a full minute after 16:00 cut the average by ~0.8 pips.
//
//  NOT FINANCIAL ADVICE. Past results do not guarantee future results; the
//  edge is small (about +0.15R per trade). Forward test before risking money.
// =============================================================================
indicator("AUDUSD Month-End Fix Fade", shorttitle = "AUD ME Fix", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// -----------------------------------------------------------------------------
//  INPUTS
// -----------------------------------------------------------------------------
G_RULE = "1. Rules (tested defaults)"
G_DISP = "2. Costs and display"

dayMode  = input.string("Last trading day of month", "Days to trade", options = ["Last trading day of month", "Every weekday (no edge - comparison only)"], group = G_RULE, tooltip = "The tested edge exists only on the last trading day of the month. 'Every weekday' is there so you can see for yourself that ordinary days do not work.")
preMins  = input.int(30, "Measure the move over the last N minutes before 16:00", minval = 5, maxval = 120, step = 5, group = G_RULE)
minMove  = input.float(3.0, "Minimum pre-fix move (pips)", minval = 0.0, step = 0.5, group = G_RULE)
stopPips = input.float(20.0, "Stop loss (pips)", minval = 1.0, step = 1.0, group = G_RULE)
tgtMode  = input.string("Give back the whole pre-fix move", "Target", options = ["Give back the whole pre-fix move", "None - time exit only"], group = G_RULE)
holdMins = input.int(60, "Close the trade N minutes after 16:00", minval = 5, maxval = 240, step = 5, group = G_RULE)

costPips   = input.float(1.0, "Round-trip cost: spread + commission + slippage (pips)", minval = 0.0, step = 0.1, group = G_DISP, tooltip = "Deducted from every simulated trade in the dashboard.")
showWin    = input.bool(true, "Shade the pre-fix window and the trade window", group = G_DISP)
showTrade  = input.bool(true, "Show entry, stop and target", group = G_DISP)
showDash   = input.bool(true, "Show dashboard", group = G_DISP)
dashPos    = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DISP)
alertFmt   = input.string("Text", "alert() message format", options = ["Text", "JSON"], group = G_DISP, tooltip = "Create the alert with 'Any alert() function call' and 'Once Per Bar Close'. JSON (symbol, action, entry, sl, tp) is for webhook bridges.")
bullCol    = input.color(#26a69a, "Buy colour", group = G_DISP)
bearCol    = input.color(#ef5350, "Sell colour", group = G_DISP)

// -----------------------------------------------------------------------------
//  CLOCK AND CALENDAR (London time)
// -----------------------------------------------------------------------------
string TZ = "Europe/London"
float pip    = syminfo.mintick < 0.0001 ? syminfo.mintick * 10 : syminfo.mintick
int   tfSec  = timeframe.in_seconds()
bool  tfOK   = timeframe.isintraday and tfSec <= preMins * 60 and (preMins * 60) % tfSec == 0 and (holdMins * 60) % tfSec == 0
int   fixMin = 16 * 60
int   refMin = fixMin - preMins
int   endMin = fixMin + holdMins

int   openMin  = hour(time, TZ) * 60 + minute(time, TZ)
int   closeMin = hour(time_close, TZ) * 60 + minute(time_close, TZ)
int   dateKey  = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)

// last Monday-Friday date of the month of time t (London calendar)
f_isLastTradingDay(int t) =>
    int y  = year(t, TZ)
    int m  = month(t, TZ)
    int d  = dayofmonth(t, TZ)
    int ny = m == 12 ? y + 1 : y
    int nm = m == 12 ? 1 : m + 1
    int lastDom = dayofmonth(timestamp(TZ, ny, nm, 1, 0, 0) - 12 * 3600000, TZ)
    int dowLast = dayofweek(timestamp(TZ, y, m, lastDom, 12, 0), TZ)
    int lastTD  = dowLast == dayofweek.saturday ? lastDom - 1 : dowLast == dayofweek.sunday ? lastDom - 2 : lastDom
    d == lastTD

bool isMonthEnd = f_isLastTradingDay(time)
bool isWeekday  = dayofweek(time, TZ) != dayofweek.saturday and dayofweek(time, TZ) != dayofweek.sunday
bool dayOK      = dayMode == "Last trading day of month" ? isMonthEnd : isWeekday

// -----------------------------------------------------------------------------
//  STATE
// -----------------------------------------------------------------------------
var float refPx   = na
var int   refDate = 0

var int   trDir   = 0
var float trEntry = na
var float trSL    = na
var float trTP    = na
var int   trBar   = 0
var int   trDate  = 0
var box   trBox   = na

var int   nTrades = 0
var int   nWins   = 0
var float sumWin  = 0.0
var float sumLoss = 0.0
var float cumPips = 0.0
var float peak    = 0.0
var float maxDD   = 0.0
var int   lossStreak = 0
var int   maxLossStreak = 0

int    sigDir   = 0
float  sigEntry = na
float  sigSL    = na
float  sigTP    = na
float  sigMove  = na
int    exitKind = 99
float  exitPips = na

// -----------------------------------------------------------------------------
//  ENGINE - runs once per CLOSED bar
// -----------------------------------------------------------------------------
if barstate.isconfirmed and tfOK
    // >>> FIX-ENGINE-BEGIN (identical in the indicator and the strategy file)
    // ---- manage an open trade (from the bar after entry) ----
    if trDir != 0 and bar_index > trBar
        bool  hitSL   = trDir == 1 ? low <= trSL : high >= trSL
        bool  hitTP   = not na(trTP) and (trDir == 1 ? high >= trTP : low <= trTP)
        bool  timeUp  = closeMin >= endMin or dateKey != trDate
        float exitPx  = na
        if hitSL
            exitPx   := trSL
            exitKind := -1
        else if hitTP
            exitPx   := trTP
            exitKind := 1
        else if timeUp
            exitPx   := close
            exitKind := 2
        if not na(exitPx)
            exitPips := trDir * (exitPx - trEntry) / pip
            trDir := 0

    // ---- 15:30 reference price ----
    if dayOK and closeMin == refMin
        refPx   := close
        refDate := dateKey

    // ---- 16:00: fade the pre-fix move ----
    if dayOK and closeMin == fixMin and refDate == dateKey and not na(refPx) and trDir == 0
        float mv = (close - refPx) / pip
        if math.abs(mv) >= minMove and mv != 0
            sigDir   := mv > 0 ? -1 : 1
            sigEntry := close
            sigSL    := close - sigDir * stopPips * pip
            sigTP    := tgtMode == "Give back the whole pre-fix move" ? refPx : na
            sigMove  := mv
            trDir    := sigDir
            trEntry  := sigEntry
            trSL     := sigSL
            trTP     := sigTP
            trBar    := bar_index
            trDate   := dateKey
    // <<< FIX-ENGINE-END

    // ---- statistics (net of costs) and drawing ----
    if exitKind != 99
        float net = exitPips - costPips
        exitPips := net
        nTrades += 1
        cumPips += net
        if net > 0
            nWins += 1
            sumWin += net
            lossStreak := 0
        else
            sumLoss += -net
            lossStreak += 1
            maxLossStreak := math.max(maxLossStreak, lossStreak)
        peak  := math.max(peak, cumPips)
        maxDD := math.max(maxDD, peak - cumPips)
        if showTrade
            box.set_right(trBox, bar_index)
            label.new(bar_index, close, (net >= 0 ? "+" : "") + str.tostring(net, "#.#") + " pips" + (exitKind == 1 ? " TP" : exitKind == -1 ? " SL" : " 17:00"), style = label.style_label_left, color = net > 0 ? color.new(bullCol, 20) : color.new(bearCol, 20), textcolor = color.white, size = size.tiny)
    if sigDir != 0 and showTrade
        float top = sigDir == 1 ? (na(sigTP) ? sigEntry + stopPips * pip : sigTP) : sigSL
        float bot = sigDir == 1 ? sigSL : (na(sigTP) ? sigEntry - stopPips * pip : sigTP)
        trBox := box.new(bar_index, top, bar_index + 1, bot, border_color = color.new(sigDir == 1 ? bullCol : bearCol, 40), bgcolor = color.new(sigDir == 1 ? bullCol : bearCol, 90))
        string tip = "Pre-fix move " + str.tostring(sigMove, "#.#") + " pips (15:30 -> 16:00 London)\nEntry " + str.tostring(sigEntry, format.mintick) + "\nStop " + str.tostring(sigSL, format.mintick) + " (" + str.tostring(stopPips, "#") + " pips)\nTarget " + (na(sigTP) ? "none (time exit)" : str.tostring(sigTP, format.mintick)) + "\nTime exit " + str.tostring(math.floor(endMin / 60)) + ":" + (endMin % 60 < 10 ? "0" : "") + str.tostring(endMin % 60) + " London"
        label.new(bar_index, sigDir == 1 ? low : high, sigDir == 1 ? "BUY fix" : "SELL fix", style = sigDir == 1 ? label.style_label_up : label.style_label_down, color = sigDir == 1 ? bullCol : bearCol, textcolor = color.white, size = size.small, tooltip = tip)

// -----------------------------------------------------------------------------
//  PLOTS
// -----------------------------------------------------------------------------
bool inPre   = dayOK and tfOK and openMin >= refMin and openMin < fixMin
bool inTrade = dayOK and tfOK and openMin >= fixMin and openMin < endMin
bgcolor(showWin and inPre ? color.new(color.orange, 88) : na, title = "Pre-fix window")
bgcolor(showWin and inTrade ? color.new(color.blue, 92) : na, title = "Trade window")
plot(dayOK and tfOK and openMin >= refMin and openMin < endMin and refDate == dateKey ? refPx : na, "15:30 reference price", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 1)

plot(sigDir, "Signal (1 buy, -1 sell)", display = display.data_window)
plot(sigEntry, "Signal entry", display = display.data_window)
plot(sigSL, "Signal stop", display = display.data_window)
plot(sigTP, "Signal target", display = display.data_window)
plot(exitKind, "Exit kind (1 TP, -1 SL, 2 time, 99 none)", display = display.data_window)
plot(exitPips, "Exit net pips", display = display.data_window)
plot(nTrades, "Sim trades", display = display.data_window)
plot(cumPips, "Sim net pips", display = display.data_window)

// -----------------------------------------------------------------------------
//  ALERTS
// -----------------------------------------------------------------------------
bool setupDay = dayOK and tfOK and closeMin == refMin
alertcondition(setupDay, "Month-end fix day (15:30)", "AUDUSD month-end fix day: setup decided at 16:00 London")
alertcondition(sigDir == 1, "Month-end fix BUY", "AUDUSD month-end fix fade: BUY at {{close}}")
alertcondition(sigDir == -1, "Month-end fix SELL", "AUDUSD month-end fix fade: SELL at {{close}}")
alertcondition(exitKind != 99, "Month-end fix trade closed", "AUDUSD month-end fix fade: trade closed")

if setupDay
    alert(syminfo.ticker + " month-end fix day: reference price " + str.tostring(refPx, format.mintick) + " at 15:30 London. Signal at the 16:00 bar close.", alert.freq_once_per_bar_close)
if sigDir != 0
    string side = sigDir == 1 ? "buy" : "sell"
    string msg  = alertFmt == "JSON" ? '{"symbol":"' + syminfo.ticker + '","action":"' + side + '","entry":' + str.tostring(sigEntry, format.mintick) + ',"sl":' + str.tostring(sigSL, format.mintick) + (na(sigTP) ? '' : ',"tp":' + str.tostring(sigTP, format.mintick)) + '}' : str.upper(side) + " " + syminfo.ticker + " @ " + str.tostring(sigEntry, format.mintick) + " | SL " + str.tostring(sigSL, format.mintick) + " | TP " + (na(sigTP) ? "none" : str.tostring(sigTP, format.mintick)) + " | close by 17:00 London"
    alert(msg, alert.freq_once_per_bar_close)
if exitKind != 99
    alert(syminfo.ticker + " month-end fix trade closed: " + (exitKind == 1 ? "TARGET" : exitKind == -1 ? "STOP" : "TIME EXIT") + " (" + str.tostring(exitPips, "#.#") + " pips net)", alert.freq_once_per_bar_close)

// -----------------------------------------------------------------------------
//  DASHBOARD
// -----------------------------------------------------------------------------
tblPos = dashPos == "Top right" ? position.top_right : dashPos == "Top left" ? position.top_left : dashPos == "Bottom right" ? position.bottom_right : position.bottom_left
var table dash = table.new(tblPos, 2, 13, bgcolor = color.new(#131722, 8), border_width = 1, border_color = color.new(color.gray, 60))

f_row(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 25), text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, r, v, text_color = c, text_halign = text.align_right, text_size = size.small)

f_num(float x, string fmt) => na(x) ? "-" : str.tostring(x, fmt)

if barstate.islast and showDash
    bool  audOK   = str.contains(syminfo.ticker, "AUDUSD")
    float liveMv  = not na(refPx) and refDate == dateKey ? (close - refPx) / pip : na
    float winRate = nTrades > 0 ? nWins / nTrades * 100 : na
    float avgP    = nTrades > 0 ? cumPips / nTrades : na
    float pf      = sumLoss > 0 ? sumWin / sumLoss : na
    string state  = not tfOK ? "use a 1-15 minute chart" : trDir != 0 ? (trDir == 1 ? "LONG open" : "SHORT open") : isMonthEnd ? "month-end day" : "waiting for month-end"
    f_row(0, "AUDUSD Month-End Fix Fade", audOK ? "AUDUSD" : "tested on AUDUSD only", audOK ? color.white : color.orange)
    f_row(1, "Status", state, not tfOK ? color.orange : trDir != 0 ? (trDir == 1 ? bullCol : bearCol) : color.white)
    f_row(2, "Today is month-end", isMonthEnd ? "yes" : "no", isMonthEnd ? bullCol : color.gray)
    f_row(3, "Move since 15:30 (pips)", f_num(liveMv, "#.#"), color.white)
    f_row(4, "Sim trades on this chart", str.tostring(nTrades), color.white)
    f_row(5, "Win rate", nTrades > 0 ? f_num(winRate, "#") + "%" : "-", color.white)
    f_row(6, "Average net pips", f_num(avgP, "#.#"), avgP > 0 ? bullCol : bearCol)
    f_row(7, "Profit factor", f_num(pf, "#.##"), pf > 1 ? bullCol : bearCol)
    f_row(8, "Net pips", f_num(cumPips, "#"), cumPips > 0 ? bullCol : bearCol)
    f_row(9, "Max drawdown (pips)", f_num(maxDD, "#"), color.white)
    f_row(10, "Max losing streak", str.tostring(maxLossStreak), color.white)
    f_row(11, "Tested 2005-2020 (1 pip cost)", "158 trades, 70% win, +3.0 pips", color.gray)
    f_row(12, "Unseen 2017-2020 test", "35 trades, 71% win, +2.9 pips", color.gray)
